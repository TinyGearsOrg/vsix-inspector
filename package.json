{
  "name": "vsix-inspector",
  "displayName": "VSIX Inspector",
  "description": "Inspect a .vsix file: bundle size breakdown, .vscodeignore misses, unbundled node_modules, and declared licenses.",
  "version": "0.0.1",
  "publisher": "TinyGearsOrg",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vsixInspector.inspect",
        "title": "Inspect VSIX"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "vsixInspector.inspect",
          "when": "resourceExtname == .vsix"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc -p tsconfig.json",
    "test": "node --test $(find out/test -name '*.test.js')",
    "package": "vsce package"
  },
  "dependencies": {
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.6",
    "@vscode/vsce": "^2.26.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0",
    "yazl": "^2.5.1"
  }
}
